<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cainiao"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_cainiao"
            android:drawableTop="@drawable/ic_cainiao"
            android:text="@string/btn_cainiao"
            android:textColor="#1677FF" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_taobao"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_taobao"
            android:drawableTop="@drawable/ic_taobao"
            android:text="@string/btn_taobao"
            android:textColor="#E4470B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pdd"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pdd"
            android:drawableTop="@drawable/ic_pdd"
            android:text="@string/btn_pdd"
            android:textColor="#D31F16" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_express"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_taobao"
            android:drawableTop="@drawable/ic_express"
            android:text="@string/btn_express"
            android:textColor="#E4470B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pdd_pending"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pdd"
            android:drawableTop="@drawable/ic_pdd"
            android:text="@string/btn_pdd_pending"
            android:textColor="#D31F16" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_douyin"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_douyin"
            android:drawableTop="@drawable/ic_douyin"
            android:text="@string/btn_douyin"
            android:textColor="#161823" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_jd"
            style="@style/CardButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card_jd"
            android:drawableTop="@drawable/ic_jd"
            android:text="@string/btn_jd"
            android:textColor="#D42317" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_bottom_bar"
        android:clipChildren="false"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_about"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_about_face"
            android:elevation="3dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.8" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_codes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_codes_entry"
            android:drawableStart="@drawable/ic_codes_white"
            android:drawablePadding="8dp"
            android:elevation="3dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_codes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
