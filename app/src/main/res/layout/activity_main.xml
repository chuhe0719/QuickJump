<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cainiao"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_cainiao"
            android:drawableTop="@drawable/ic_cainiao"
            android:text="@string/btn_cainiao"
            android:textColor="#1677FF" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_taobao"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_taobao"
            android:drawableTop="@drawable/ic_taobao"
            android:text="@string/btn_taobao"
            android:textColor="#E4470B" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pdd"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pdd"
            android:drawableTop="@drawable/ic_pdd"
            android:text="@string/btn_pdd"
            android:textColor="#D31F16" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_express"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_taobao"
            android:drawableTop="@drawable/ic_express"
            android:text="@string/btn_express"
            android:textColor="#E4470B" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pdd_pending"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pdd"
            android:drawableTop="@drawable/ic_pdd"
            android:text="@string/btn_pdd_pending"
            android:textColor="#D31F16" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_douyin"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_douyin"
            android:drawableTop="@drawable/ic_douyin"
            android:text="@string/btn_douyin"
            android:textColor="#161823" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_jd"
            style="@style/CardButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card_jd"
            android:drawableTop="@drawable/ic_jd"
            android:text="@string/btn_jd"
            android:textColor="#D42317" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_about"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_fab"
            android:elevation="4dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/about_mark"
            android:textColor="#1677FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
